{
    "format_version": "1.21.0",
    "minecraft:entity": {
        "description": {
            "identifier": "miner_bot_bp:robot",
            "is_summonable": true,
            "is_spawnable": true
        
        },
        "component_groups": {
            "robot:is_tamed": {
                "minecraft:is_tamed": {},
                "minecraft:behavior.move_to_owner": {
                    "priority": 4,
                    "speed_multiplier": 1.0
                },
                "minecraft:behavior.follow_owner": {
                    "priority": 5,
                    "start_distance": 5.0,
                    "stop_distance": 2.0
                },
                 "minecraft:behavior.look_at_player": {
                "priority": 6,
                "look_distance": 10,
                "probability": 0.03
            }
            },
            "robot:scouting": {
                "minecraft:behavior.random_stroll": {
                    "priority": 0,
                    "speed_multiplier": 1.2
                }
            },
            "robot:idle": {
                "minecraft:behavior.random_stroll": {
                    "priority": 1,
                    "speed_multiplier": 1.0
                },
                "minecraft:behavior.random_look_around": { "priority": 2 }
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": [ "robot", "monster" ]
            },
            "minecraft:collision_box": {
                "width": 0.8,
                "height": 2.2
            },
            "minecraft:physics": {
                "has_collision": true,
                "has_gravity": true
            },
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:jump.static": {},
            "minecraft:movement": { "value": 0.2 },
            "minecraft:movement.basic": {},
            "minecraft:navigation.walk": {
                "can_walk": true,
                "avoid_sun": true,
                "can_pass_doors": true,
                "can_open_doors": true
            },
            "minecraft:inventory": {
                "inventory_size": 9,
                "container_type": "container"
            },
            "minecraft:tameable": {
                "probability": 1.0,
                "tame_event": { "event": "my:follow_event" }
            },
            "minecraft:interact": {
                "interactions": [
                {
                    "on_interact": {},
                    "interact_text": "Talk to Miner Bot",
                    "swing": false,
                    "play_sounds": ""
                } 
            ]
            }
        },
        "events": {
                "minecraft:entity_spawned": {
                    "add": {
                        "component_groups": [
                            "robot:idle"
                        ]
                    },
                    "remove": {
                        "component_groups": [
                            "robot:is_tamed",
                            "robot:scouting"
                        ]
                    }
                },
                "my:follow_event": {
                    "remove": {
                        "component_groups": [
                            "robot:idle",
                            "robot:scouting"
                        ]
                    },
                    "add": {
                        "component_groups": [
                            "robot:is_tamed"
                        ]
                    }
                },
                "my:stop_follow_event": {
                    "remove": {
                        "component_groups": [
                            "robot:is_tamed"
                        ]
                    }
                },
                "my:find_item_event": {
                    "remove": { "component_groups": ["robot:is_tamed", "robot:idle"]},
                    "add": { "component_groups": ["robot:scouting"]}
                },
                "my:return_from_scouting": {
                    "remove": { "component_groups": ["robot:scouting"] },
                    "add": { "component_groups": ["robot:is_tamed"] }
                }
            }
    }
}