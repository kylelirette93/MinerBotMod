{
    "format_version": "1.21.0",
    "minecraft:entity": {
        "description": {
            "identifier": "miner_bot_bp:robot",
            "is_summonable": true,
            "is_spawnable": true
        
        },
        "components": {
            "minecraft:movement": {
                "value": 0.2
            },
            "minecraft:type_family": {
                "family": [ "robot", "monster" ]
            },
            "minecraft:collision_box": {
                "width": 0.6,
                "height": 1
            },
            "minecraft:physics": {
                "has_collision": true,
                "has_gravity": true
            },
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:jump.static": {},
            "minecraft:movement.basic": {},
            "minecraft:navigation.walk": {
                "can_walk": true,
                "avoid_sun": true,
                "can_pass_doors": true,
                "can_open_doors": true
            },
            "minecraft:behavior.random_stroll": {
                "priority": 7,
                "speed_multiplier": 2
            },
            "minecraft:behavior.random_look_around": {
                "priority": 8
            },
            "minecraft:behavior.look_at_player": {
                "priority": 6,
                "look_distance": 10,
                "probability": 0.03
            },
            "minecraft:interact": {
                "interactions": [
                    {
                        "on_interact": {
                            "filters": {
                                "test": "is_family",
                                "subject": "other",
                                "value": "player"
                            },
                            "event": "break_box",
                            "target": "self"
                        },
                        "swing": true,
                        "spawn_items": {
                            "table": "loot_tables/chests/random_find.json"
                        }
                    }
                ]
            }
        }
    }
}