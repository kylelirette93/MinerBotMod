{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "./src",
        "outDir": "./scripts",
        "paths": {
            "@minecraft/*": ["../node_modules/@minecraft/*"]
        },
        "allowJs": true,
        "strict": true,
        "noEmit": false,
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "scripts"]
}